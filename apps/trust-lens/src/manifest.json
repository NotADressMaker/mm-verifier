{
  "manifest_version": 3,
  "name": "MAMV Lens",
  "version": "0.1.0",
  "description": "MAMV validation visibility and risk flags",
  "permissions": ["storage", "activeTab", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MAMV Lens"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "options_page": "options.html"
}
