# Blockchain Configuration
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc
MAMV_CHAIN_ID=421614
PRIVATE_KEY=your_deployer_private_key_here
ETHERSCAN_API_KEY=your_arbiscan_api_key
MARKETPLACE_ADDRESS=0x0000000000000000000000000000000000000000
STAKING_ADDRESS=0x0000000000000000000000000000000000000000

# Database
DB_PASSWORD=changeme

# WETH Configuration
# Arbitrum One: 0x82aF49447D8a07e3bd95BD0d56f35241523fBab1
# Arbitrum Sepolia: 0x980B62Da83eFf3D4576C647993b0c1D7faf17c73
WETH_ADDRESS=0x980B62Da83eFf3D4576C647993b0c1D7faf17c73

# Bond Amounts (in ETH units, e.g., 0.02 = 0.02 WETH)
EVAL_BOND=0.02
AUDITOR_MIN_STAKE=0.25
DISPUTE_BOND=0.01

# Chainlink VRF (Arbitrum Sepolia)
CHAINLINK_VRF_COORDINATOR=0x5CE8D5A2BC84beb22a398CCA51996F7930313D61
CHAINLINK_VRF_KEY_HASH=0x1770bdc7eec7771f7ba4ffd640f34260d7f095b79c92d34a5b2551d6f6cfd2be
CHAINLINK_SUBSCRIPTION_ID=your_subscription_id

# LLM Provider API Keys
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_API_KEY=your-google-api-key
COHERE_API_KEY=your-cohere-api-key
HUGGINGFACE_API_KEY=your-huggingface-key

# API Server Configuration
API_PORT=3000
API_HOST=localhost
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/llm_verifier
MOCK_VERIFIER=true
MOCK_CHAIN=true
MOCK_PROVIDERS=true
MOCK_SCENARIO=happy
MOCK_VERIFIER_DELAY_MS=150
PROVIDER_MODE=mock
CHAIN_MODE=mock
HASHED_ONLY_DEFAULT=true

# Verifier Node Configuration
VERIFIER_PRIVATE_KEY=your_verifier_wallet_private_key
VERIFIER_STAKE_AMOUNT=100000000000000000
VERIFIER_NODE_ID=verifier-1
AUTO_COMMIT_EVALUATIONS=true
MAX_CONCURRENT_JOBS=5

# Redis Configuration (for job queue)
REDIS_URL=redis://localhost:6379

# IPFS Configuration (for evidence storage)
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn

# Dashboard (Vite)
VITE_API_BASE_URL=http://localhost:3000

# Security
JWT_SECRET=your_jwt_secret_key
# JWTs used with organization routes must include `sub` (User.id) and `organizationId`.
# Organization API keys are created through the API and only their SHA-256 hash is stored.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Feature Flags
ENABLE_TEE_ATTESTATION=false
ENABLE_ZK_PROOFS=false
ENABLE_PRIVACY_MODE=true

# Validator Service Configuration
MAMV_API_BASE_URL=http://localhost:3000
VALIDATOR_ID=validator-local
VALIDATOR_PORT=4010
VALIDATOR_POLL_INTERVAL_MS=4000
VALIDATOR_DB_PATH=./services/validator/validator.db
VALIDATOR_RECEIPT_BASE_URL=http://localhost:4010
VALIDATOR_VERIFIER_KEY_ID=local-key

# MAMV Education: raw educational content is processed ephemerally and is not persisted by this route.
EDUCATION_MAX_PAYLOAD=100kb
