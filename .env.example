# Blockchain Configuration
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc
PRIVATE_KEY=your_deployer_private_key_here
ETHERSCAN_API_KEY=your_arbiscan_api_key

# Chainlink VRF (Arbitrum Sepolia)
CHAINLINK_VRF_COORDINATOR=0x5CE8D5A2BC84beb22a398CCA51996F7930313D61
CHAINLINK_VRF_KEY_HASH=0x1770bdc7eec7771f7ba4ffd640f34260d7f095b79c92d34a5b2551d6f6cfd2be
CHAINLINK_SUBSCRIPTION_ID=your_subscription_id

# LLM Provider API Keys
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_API_KEY=your-google-api-key
COHERE_API_KEY=your-cohere-api-key
HUGGINGFACE_API_KEY=your-huggingface-key

# API Server Configuration
API_PORT=3000
API_HOST=localhost
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/llm_verifier

# Verifier Node Configuration
VERIFIER_PRIVATE_KEY=your_verifier_wallet_private_key
VERIFIER_STAKE_AMOUNT=100000000000000000
VERIFIER_NODE_ID=verifier-1
AUTO_COMMIT_EVALUATIONS=true
MAX_CONCURRENT_JOBS=5

# Redis Configuration (for job queue)
REDIS_URL=redis://localhost:6379

# IPFS Configuration (for evidence storage)
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn

# Security
JWT_SECRET=your_jwt_secret_key
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Feature Flags
ENABLE_TEE_ATTESTATION=false
ENABLE_ZK_PROOFS=false
ENABLE_PRIVACY_MODE=true
