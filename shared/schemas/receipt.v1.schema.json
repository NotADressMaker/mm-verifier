{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "receipt_version",
    "task_id",
    "generated_at",
    "input_hash",
    "output_hash",
    "score_bps",
    "verdict",
    "worthy",
    "evidence",
    "provenance",
    "explain"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "version": {
      "const": "1.0.0"
    },
    "receipt_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "generated_at": {
      "type": "integer",
      "minimum": 1
    },
    "input_hash": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "output_hash": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "score_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "verdict": {
      "type": "boolean"
    },
    "worthy": {
      "type": "boolean"
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_hash",
        "bundle_uri",
        "bundle_version"
      ],
      "properties": {
        "bundle_hash": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{64}$"
        },
        "bundle_uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "bundle_version": {
          "type": "string",
          "enum": [
            "0.1",
            "0.2",
            "0.3"
          ]
        }
      }
    },
    "plaintext_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plaintext_commitment_hash",
        "signer",
        "signature",
        "signed_at",
        "statement"
      ],
      "properties": {
        "plaintext_commitment_hash": {
          "type": "string"
        },
        "signer": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "signed_at": {
          "type": "integer"
        },
        "statement": {
          "type": "string"
        }
      }
    },
    "metering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "llm_calls",
        "total_tokens",
        "execution_ms"
      ],
      "properties": {
        "llm_calls": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "execution_ms": {
          "type": "integer",
          "minimum": 0
        },
        "retrieval_calls": {
          "type": "integer",
          "minimum": 0
        },
        "bundle_size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "llm_provider",
        "llm_model"
      ],
      "properties": {
        "verifier_node": {
          "type": "string"
        },
        "software_version": {
          "type": "string"
        },
        "llm_provider": {
          "type": "string"
        },
        "llm_model": {
          "type": "string"
        }
      }
    },
    "chain_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "contract_address",
        "finalized_at",
        "block_number",
        "tx_hash"
      ],
      "properties": {
        "chain_id": {
          "type": "integer",
          "minimum": 1
        },
        "contract_address": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$"
        },
        "finalized_at": {
          "type": "integer",
          "minimum": 1
        },
        "block_number": {
          "type": "integer",
          "minimum": 0
        },
        "tx_hash": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{64}$"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signer",
        "signature",
        "signed_at"
      ],
      "properties": {
        "signer": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]+$"
        },
        "signed_at": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "model_commitments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "model",
          "model_commitment_hash",
          "inference_config_hash"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "model_commitment_hash": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{64}$"
          },
          "inference_config_hash": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "reasoning_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_hash",
        "step_count"
      ],
      "properties": {
        "trace_hash": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{64}$"
        },
        "trace_uri": {
          "type": "string"
        },
        "step_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "zk_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof",
        "public_inputs",
        "proof_system"
      ],
      "properties": {
        "proof": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]+$"
        },
        "public_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_hash",
            "output_hash",
            "model_commitment_hash",
            "score_bps",
            "bundle_hash"
          ],
          "properties": {
            "input_hash": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{64}$"
            },
            "output_hash": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{64}$"
            },
            "model_commitment_hash": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{64}$"
            },
            "score_bps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "bundle_hash": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{64}$"
            }
          }
        },
        "proof_system": {
          "type": "string"
        }
      }
    },
    "explain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "score_components",
        "score_components_detail",
        "claim_summary",
        "highlights",
        "checks",
        "checks_fired",
        "uncertain_claims",
        "score_adjustments",
        "contradictions_found",
        "citation_checks",
        "model_disagreement"
      ],
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "score_components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "score_bps"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "score_bps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "weight_bps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "notes": {
                "type": "string",
                "maxLength": 2048
              }
            }
          }
        },
        "score_components_detail": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coverage_bps",
            "contradiction_penalty_bps",
            "citation_quality_bps",
            "final_score_bps"
          ],
          "properties": {
            "coverage_bps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "contradiction_penalty_bps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "citation_quality_bps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "final_score_bps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        },
        "claim_summary": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cluster_id",
              "canonical_text",
              "supported_by",
              "contradicted_by",
              "citations"
            ],
            "properties": {
              "cluster_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "canonical_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "supported_by": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "contradicted_by": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "severity": {
                "type": "string",
                "enum": [
                  "LOW",
                  "MED",
                  "HIGH"
                ]
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "url"
                  ],
                  "properties": {
                    "url": {
                      "type": "string",
                      "minLength": 1
                    },
                    "domain": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "citations": {
              "type": "object",
              "additionalProperties": true
            },
            "contradictions": {
              "type": "object",
              "additionalProperties": true
            },
            "disagreement": {
              "type": "object",
              "additionalProperties": true
            },
            "policy": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "checks_fired": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "severity",
              "summary"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "claim_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        },
        "uncertain_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id",
              "text",
              "reason"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "score_adjustments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "score_bps",
              "direction"
            ],
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "score_bps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "weight_bps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "contribution_bps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "direction": {
                "type": "string",
                "enum": [
                  "up",
                  "down",
                  "neutral"
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 2048
              }
            }
          }
        },
        "contradictions_found": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "severity",
              "summary",
              "evidence_refs"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "severity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "citation_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim",
              "sources",
              "verdict"
            ],
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "verdict": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "notes": {
                "type": "string",
                "maxLength": 2048
              }
            }
          }
        },
        "model_disagreement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "models",
            "agreement_rate"
          ],
          "properties": {
            "models": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "agreement_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "clusters": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "debug_trace_uri": {
          "type": "string"
        },
        "debug_trace": {
          "type": "object",
          "additionalProperties": true
        },
        "plaintext_verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plaintext_commitment_hash",
            "signer",
            "signature",
            "signed_at",
            "statement"
          ],
          "properties": {
            "plaintext_commitment_hash": {
              "type": "string"
            },
            "signer": {
              "type": "string"
            },
            "signature": {
              "type": "string"
            },
            "signed_at": {
              "type": "integer"
            },
            "statement": {
              "type": "string"
            }
          }
        },
        "bft_quorum": {
          "type": "boolean"
        },
        "outliers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vote_merkle_root": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{64}$"
        },
        "vote_merkle_proofs": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{64}$"
            }
          }
        },
        "timings_ms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fetch": {
              "type": "integer",
              "minimum": 0
            },
            "program_run": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "input_checked": {
      "type": "string"
    },
    "output_checked": {
      "type": "string"
    },
    "claim_summary": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "Supported",
        "Mostly supported",
        "Mixed evidence",
        "Unsupported",
        "Contradicted",
        "Unable to verify"
      ]
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "votes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "model",
          "vote"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "vote": {
            "type": "string",
            "enum": [
              "support",
              "contradict",
              "abstain",
              "uncertain"
            ]
          },
          "score_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "outliers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "score_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    },
    "quorum_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "met",
        "method"
      ],
      "properties": {
        "met": {
          "type": "boolean"
        },
        "method": {
          "type": "string",
          "enum": [
            "single_verifier",
            "supermajority",
            "bft_style_weighted"
          ]
        },
        "threshold_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "observed_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "participant_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "vote_merkle_root": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "vote_merkle_proofs": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{64}$"
        }
      }
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^0x[a-fA-F0-9]{64}$"
          },
          "retrieved_at": {
            "type": "integer",
            "minimum": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "receipt_hash": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{64}$"
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "address": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$"
        },
        "signature": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]+$"
        },
        "signed_at": {
          "type": "integer",
          "minimum": 1
        },
        "scheme": {
          "type": "string"
        }
      }
    },
    "onchain_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_status"
      ],
      "properties": {
        "chain_id": {
          "type": "integer",
          "minimum": 1
        },
        "contract_address": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$"
        },
        "tx_hash": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{64}$"
        },
        "block_number": {
          "type": "integer",
          "minimum": 0
        },
