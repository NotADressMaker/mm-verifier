{
  "name": "@mamv/verifier-node",
  "version": "0.1.0",
  "description": "Verifier node for MAMV - processes verification jobs and submits evaluations",
  "main": "dist/index.js",
  "bin": {
    "mamv": "dist/cli/mamv.js",
    "mmv": "dist/cli/mamv.js"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "list-programs": "ts-node src/cli/programs.ts list",
    "verify-program": "ts-node src/cli/programs.ts verify",
    "hash-program": "ts-node src/cli/programs.ts hash",
    "auditor": "ts-node src/cli/auditor.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "verifier",
    "llm",
    "blockchain",
    "ai"
  ],
  "author": "MAMV Team",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.12.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.9.0",
    "openai": "^4.24.0",
    "@anthropic-ai/sdk": "^0.12.0",
    "@google/generative-ai": "^0.1.3",
    "cohere-ai": "^7.6.2",
    "axios": "^1.6.5",
    "bull": "^4.12.0",
    "redis": "^4.6.12",
    "semver": "^7.6.3",
    "winston": "^3.11.0",
    "prom-client": "^15.1.0",
    "ipfs-http-client": "^60.0.1",
    "crypto": "^1.0.1",
    "natural": "^6.10.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/natural": "^5.1.5",
    "@types/jest": "^29.5.11",
    "@types/chai": "^4.3.11",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "chai": "^4.3.10",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "prettier": "^3.1.1"
  },
  "exports": {
    "./ovp": "./dist/ovp/index.js"
  }
}
